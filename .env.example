# ── DART OpenAPI ─────────────────────────────────────────────
# https://opendart.fss.or.kr 에서 무료 발급 (가입 후 즉시)
DART_API_KEY=

# ── KRX (pykrx 1.2.8+ 는 로그인이 필요하다) ──────────────────
# 상위 폴더 .env 에 있으면 그쪽이 먼저 읽히므로 여기 비워도 된다
KRX_ID=
KRX_PW=

# ── NAVER API HUB — 뉴스에 인용된 증권사 목표가 수집용 (선택) ──
# https://www.ncloud.com > NAVER API HUB > 이용신청 > Application 등록 > 검색
# 없으면 목표가 수집 단계만 건너뛰고 나머지는 그대로 돌아간다
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 결과를 쓸 옵시디언 볼트 경로 (선택) ───────────────────────
# 비우면 screener/vault/ 에 만든다. 슬래시로 적는다
VAULT_ROOT=
